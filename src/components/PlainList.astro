---
import classNames from 'classnames';

export interface Props extends astroHTML.JSX.BaseHTMLAttributes {
  as?: 'ul' | 'ol';
  spacing?: 'none' | 'small' | 'normal' | 'large';
}

const { as: Element = 'ul', spacing = 'normal', class: className, slot, ...rest } = Astro.props;

const classes = classNames('list', spacing, className);
---

<Element class={classes} {...rest}>
  <slot />
</Element>

<style>
  .list {
    list-style-type: none;
    margin-block-start: 0;
    margin-block-end: 1rem;
    padding: 0;    
    --gap: var(--list-gap);
    

    &.none {
      --gap: 0;
    }

    &.small {      
      --gap: var(--list-gap-small)
    }

    &.large {
      --gap: var(--list-gap-large)
    }
  }

  .list > :global(li):not(:last-child) {
    margin-block-end: calc(var(--gap) * var(--list-gap-multiple));
  }

  
</style>
